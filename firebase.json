{
  "hosting": {
    "site": "ask-the-multiverse",
    "public": "frontend/dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      { "source": "/multiverse/api/**", "run": { "serviceId": "multiverse-api", "region": "asia-south1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://arunangshupramanik.com https://www.arunangshupramanik.com https://arunangshu-pramanik-portfolio.web.app https://arunangshu-pramanik-portfolio.firebaseapp.com" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ] }
    ]
  }
}
